{
  "name": "gy-ui-plus",
  "publishConfig": {
    "access": "public"
  },
  "author": "zyj",
  "license": "MIT",
  "version": "1.0.18",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "lib": "pnpm --filter gy-ui-plus build",
    "deploy": "deploy.sh",
    "docs:dev": "pnpm --filter @gy-ui-plus/docs dev",
    "docs:build": "pnpm --filter @gy-ui-plus/docs build",
    "docs:preview": "pnpm --filter @gy-ui-plus/docs preview",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s lint:*",
    "format": "prettier --write --experimental-cli src/",
    "dev": "pnpm --filter @gy-ui-plus/docs dev",
    "build": "pnpm --filter gy-ui-plus build",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.0.5",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-oxlint": "~1.29.0",
    "eslint-plugin-vue": "~10.5.1",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.29.0",
    "prettier": "3.6.2",
    "sass": "^1.97.1",
    "typescript": "~5.9.0",
    "vue-tsc": "^3.1.5"
  }
}
